{
  "name": "vtube-pro",
  "version": "1.0.0-beta.16",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Any model, any webcam: VTuber studio with procedural eyes/mouth, soft-rig, physics, AI model generation.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit -p .",
    "stream": "vite build && tsx server/index.ts",
    "smoke": "node tools/setup/smoke.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@ricky0123/vad-web": "^0.0.31",
    "express": "^5.2.1",
    "hls.js": "^1.7.3",
    "n8ao": "^2.0.1",
    "onnxruntime-web": "^1.30.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "gltf-validator": "^2.0.0-dev.3.10",
    "pixelmatch": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "private": true
}
