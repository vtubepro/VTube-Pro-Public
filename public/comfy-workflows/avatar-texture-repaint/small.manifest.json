 "steps": [
  "Load your texture sheet (the PNG from your model) in \"Your texture\".",
  "Load a picture of the character in \"Your reference\".",
  "Change the words if you like, then press Run."
 ],
 "tips": [
  "Faces stay hand-drawn: repaint clothes and hair, then fix the face by hand.",
