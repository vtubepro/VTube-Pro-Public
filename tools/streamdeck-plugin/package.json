{
  "name": "vtube-pro-streamdeck",
  "version": "1.1.0",
  "private": true,
  "description": "VTube Pro Stream Deck plugin (Stream Deck SDK v2). See docs/STREAM_DECK.md",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "pack:node": "node pack.mjs",
    "pack": "npm run build && streamdeck pack com.vtubepro.deck.sdPlugin --output release --force",
    "validate": "streamdeck validate com.vtubepro.deck.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
